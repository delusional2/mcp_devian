{
  "manifest_version": "0.4",
  "name": "mcp-devian",
  "display_name": "Адопты: DeviantArt и Toyhouse",
  "version": "0.3.0",
  "description": "Следит за группами DeviantArt и форумами Toyhouse, подсказывает цены и публикует по её «го».",
  "long_description": "После установки просто напиши Claude «давай настроим помощника по адоптам» — он сам задаст вопросы. Ничего не публикует.",
  "author": {
    "name": "Andrei Bugerov"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/delusional2/mcp_devian"
  },
  "server": {
    "type": "uv",
    "entry_point": "src/mcp_devian/__main__.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--no-dev",
        "--directory",
        "${__dirname}",
        "python",
        "-m",
        "mcp_devian",
        "serve"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "tools": [
    {
      "name": "get_settings",
      "description": "Настройки и вопросы для первой настройки"
    },
    {
      "name": "update_settings",
      "description": "Сохранить её ответы"
    },
    {
      "name": "da_group_folders",
      "description": "Папки группы DeviantArt"
    },
    {
      "name": "add_da_folders",
      "description": "Добавить папки групп в отслеживание"
    },
    {
      "name": "remove_da_folders",
      "description": "Убрать папки групп"
    },
    {
      "name": "set_background_checks",
      "description": "Фоновая проверка с уведомлениями"
    },
    {
      "name": "bot_login",
      "description": "Войти в аккаунт в окне бота"
    },
    {
      "name": "check_now",
      "description": "Проверить прямо сейчас"
    },
    {
      "name": "check_status",
      "description": "Итог проверки"
    },
    {
      "name": "list_new_adopts",
      "description": "Свежие лоты DeviantArt"
    },
    {
      "name": "list_lf_threads",
      "description": "Треды Toyhouse, где ищут персов"
    },
    {
      "name": "list_sale_threads",
      "description": "Треды Toyhouse с продажей"
    },
    {
      "name": "pending_digest",
      "description": "Что нового с прошлого раза"
    },
    {
      "name": "dismiss",
      "description": "Скрыть находки"
    },
    {
      "name": "sources_status",
      "description": "Когда проверялся каждый источник"
    },
    {
      "name": "read_thread",
      "description": "Первый пост треда Toyhouse"
    },
    {
      "name": "market_forecast",
      "description": "Прогноз цены по похожим лотам"
    },
    {
      "name": "my_works_overview",
      "description": "Её работы и как они продаются"
    },
    {
      "name": "leave_feedback",
      "description": "Сохранить её отзыв"
    },
    {
      "name": "feedback_report",
      "description": "Отзывы одним текстом для отправки"
    },
    {
      "name": "feedback_sent",
      "description": "Отметить отзывы отправленными"
    },
    {
      "name": "da_connect",
      "description": "Подключить DeviantArt (кнопка «Разрешить»)"
    },
    {
      "name": "da_status",
      "description": "Подключён ли DeviantArt"
    },
    {
      "name": "add_group_to_preset",
      "description": "Добавить группу в набор"
    },
    {
      "name": "remove_group_from_preset",
      "description": "Убрать группу из набора"
    },
    {
      "name": "recent_images",
      "description": "Последние картинки для публикации"
    },
    {
      "name": "prepare_deviantart_publish",
      "description": "Черновик публикации на DeviantArt"
    },
    {
      "name": "set_reply_template",
      "description": "Её шаблон отклика"
    },
    {
      "name": "add_character",
      "description": "Добавить перса на продажу"
    },
    {
      "name": "remove_character",
      "description": "Убрать перса"
    },
    {
      "name": "suggest_replies",
      "description": "LF-треды под её персов"
    },
    {
      "name": "prepare_toyhouse_reply",
      "description": "Черновик отклика на Toyhouse"
    },
    {
      "name": "inspect_reply_form",
      "description": "Посмотреть форму ответа в треде"
    },
    {
      "name": "submit_draft",
      "description": "Отправить черновик после её «го»"
    },
    {
      "name": "draft_status",
      "description": "Статус отправки"
    },
    {
      "name": "cancel_draft",
      "description": "Отменить черновик"
    },
    {
      "name": "list_drafts",
      "description": "Открытые черновики"
    },
    {
      "name": "my_auctions",
      "description": "Её аукционы: ставки и максимум"
    },
    {
      "name": "auction_status",
      "description": "Ставки на аукционе по ссылке"
    }
  ],
  "tools_generated": true,
  "prompts_generated": true,
  "compatibility": {
    "platforms": [
      "darwin"
    ]
  },
  "keywords": [
    "deviantart",
    "toyhouse",
    "adopts",
    "monitoring"
  ],
  "license": "MIT"
}
